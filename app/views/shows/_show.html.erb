<a
  href="/<%= show.slug %>"
  data-turbo-frame="_top"
  data-favourites-target="featuredShow"
  data-sort-date="<%= show.date.iso8601 %>"
  data-sort-venue="<%= show.venue.name %>"
  data-sort-city="<%= show.venue.city %>"
  <% if show.title.present? %>
    title="<%= show.title %>"
  <% end %>
  class="featured-item featured-show"
>
  <div class="indicator w-full">

    <div class="concert-recording-badges">

      <% active_recordings = show.recordings.where(is_active: true).to_a %>

      <% if active_recordings.any? && active_recordings.all?(&:is_incomplete) %>
        <span class="badge badge-error bg-opacity-60 backdrop-blur shadow">
          Incomplete
        </span>
      <% end %>

      <span class="badge badge-primary bg-opacity-60 backdrop-blur shadow">
        <%= active_recordings.size %>
        tape<%= 's' unless active_recordings.size == 1 %>
      </span>

      <% if show.duration&.nonzero? %>
        <span class="badge badge-neutral bg-opacity-60 backdrop-blur shadow">
          <% minutes = (show.duration / 60).floor %>
          <% hours = (minutes / 60).floor %>
          <%= format('%01d', hours) %>hr<%= format('%02d', minutes % 60) %>
        </span>
      <% end %>

      <% unless show.average_rating.nil? or show.count_ratings < 3 %>
        <span class="badge badge-warning bg-opacity-60 backdrop-blur shadow">
          <%= format('%.1f', show.average_rating) %>&#9733;
        </span>
      <% end %>

    </div>

    <% concert_title = show.title.to_s.strip %>
    <% concert_badge = concert_type_badge(concert_title) %>

    <% if concert_badge %>
      <span class="indicator-item badge badge-secondary bg-opacity-60 backdrop-blur shadow transform-none indicator-start indicator-bottom ml-3 mb-3"
            title="<%= concert_title %>">
        <%= concert_badge %>
      </span>
    <% end %>

    <img class="rounded-xl" src="<%= show.poster_url || (asset_path 'missing.png') %>"/>
  </div>


  <h4 class="text-primary mt-1 flex items-center justify-center gap-1 whitespace-nowrap">
    <%= show.date %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
         stroke="currentColor" class="size-6 shrink-0 favourite-icon active hidden">
      <path stroke-linecap="round" stroke-linejoin="round"
            d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>
    </svg>
  </h4>

  <small>

    <% if (artist = @artists.find { |a| a.id == show.artist_id }) %>
      <%= artist.name %> &bull;
    <% end %>

    <%= CGI.unescapeHTML show.venue.name %> &bull;
    <%= CGI.unescapeHTML [show.venue.city, show.venue.region, show.venue.country.name].reject(&:blank?).join(', ') %>
  </small>
</a>
