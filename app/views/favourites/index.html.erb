<% content_for :head do %>
<meta name="turbo-cache-control" content="no-cache">
<% end %>

<% content_for :meta_title, "Favourites on Gizz Tapes" %>

<div class="container mx-auto mt-8 px-5"
     data-action="keydown@window->favourites#handleFusionKey
                 mousedown@window->favourites#handleGroupSelectionMouseDown:capture
                 mousemove@window->favourites#moveGroupMarquee
                 mouseup@window->favourites#endGroupMarquee
                 blur@window->favourites#handleGroupSelectionBlur
                 click@window->favourites#guardMarqueeClick:capture">
    <h2 class="text-3xl font-bold mb-8 text-center text-black dark:text-white">
        Favourite Shows
    </h2>

    <div class="card bg-base-100 shadow-xl mb-5">
        <div class="card-body py-5 px-3">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4 px-2">
                <label class="flex items-center gap-2 text-sm">
                    <span>Sort by</span>
                    <select
                        data-favourites-target="sortSelect"
                        data-action="change->favourites#sortFavourites"
                        class="select select-bordered select-sm"
                        aria-label="Sort favourite shows"
                    >
                        <option value="date-desc">Newest show</option>
                        <option value="date-asc">Oldest show</option>
                        <option value="favourite-desc">Recently favourited</option>
                        <option value="favourite-asc">Earliest favourited</option>
                        <option value="city-asc">City A–Z</option>
                        <option value="venue-asc">Venue A–Z</option>
                        <option value="fusion">Intertwined</option>
                    </select>
                </label>

<button
    type="button"
    data-favourites-target="linkButton"
    data-action="click->favourites#toggleLinkMode"
    class="btn btn-outline btn-sm"
>
    Fuse shows
</button>

                <button
                    type="button"
                    data-favourites-target="linkFinish"
                    data-action="click->favourites#finishLinking"
                    class="btn btn-primary btn-sm hidden"
                    disabled
                >
                    Fuse
                </button>

                <button
                    type="button"
                    data-favourites-target="shuffleButton"
                    data-action="click->favourites#shuffleFavourites"
                    class="btn btn-outline btn-sm"
                >
                    Shuffle
                </button>
            </div>

            <div data-favourites-target="floatingControls"
                 class="fusion-floating-controls hidden">

                <span data-favourites-target="floatingCount"
                  class="text-sm font-medium">
                0 selected
            </span>

                <button type="button"
                        data-favourites-target="floatingFinish"
                        data-action="click->favourites#finishLinking"
                        class="btn btn-sm fusion-confirm-button"
                        disabled>
                    Fuse
                </button>

                <button type="button"
                        data-action="click->favourites#toggleLinkMode"
                        class="btn btn-outline btn-sm">
                    Cancel
                </button>

            </div>
            <p data-favourites-target="linkStatus" class="text-sm px-2 mb-2" role="status" aria-live="polite"></p>

            <div data-action="mousedown->favourites#startGroupMarquee contextmenu->favourites#suppressGroupContextMenu dragstart->favourites#guardMarqueeDrag click->favourites#selectShow dragover->favourites#groupDragOver dragleave->favourites#groupDragLeave drop->favourites#groupDrop" busy data-favourites-target="grid" id="favourites-grid" class="responsive-grid">

            </div>

            <div
                class="pointer-events-none absolute inset-0 z-10 hidden [[busy]~&]:flex items-center justify-center bg-gray-100 bg-opacity-25 dark:bg-gray-900 dark:bg-opacity-25 backdrop-blur"
            >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                    stroke="currentColor" class="size-6 animate-spin">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
            </div>
        </div>
    </div>
</div>
